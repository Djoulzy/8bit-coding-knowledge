000198r 2               ; Bounded semantic map. A zero virtual cell replaces out-of-grid hardware reads
000198r 2               ; during y=150/170 transitions; this is an explicit provisional policy.
000198r 2               collision_probe:
000198r 2               .if FULL_GAME
000198r 2  4C rr rr         jmp full_collision_probe
00019Br 2               .else
00019Br 2                   lda #0
00019Br 2                   sta blocked
00019Br 2                   sta object_status
00019Br 2                   lda #4
00019Br 2                   sta door_status
00019Br 2                   lda actor_x
00019Br 2                   cmp #40
00019Br 2                   bcs block_actor
00019Br 2                   lda actor_y
00019Br 2                   cmp #140
00019Br 2                   bcc block_actor
00019Br 2                   cmp #181
00019Br 2                   bcs block_actor
00019Br 2                   lda actor_x
00019Br 2                   sta grid_base
00019Br 2                   lda actor_y
00019Br 2                   cmp #140
00019Br 2                   bne :+
00019Br 2                   lda grid_base
00019Br 2                   clc
00019Br 2                   adc #80
00019Br 2                   sta grid_base
00019Br 2               :
00019Br 2                   lda actor_y
00019Br 2                   cmp #160
00019Br 2                   bne :+
00019Br 2                   lda grid_base
00019Br 2                   clc
00019Br 2                   adc #40
00019Br 2                   sta grid_base
00019Br 2               :
00019Br 2                   lda facing
00019Br 2                   beq probe_down
00019Br 2                   cmp #1
00019Br 2                   beq probe_right
00019Br 2                   cmp #2
00019Br 2                   beq probe_left
00019Br 2                   jmp probe_up
00019Br 2               block_actor:
00019Br 2                   lda #1
00019Br 2                   sta blocked
00019Br 2                   rts
00019Br 2               probe_down:
00019Br 2                   lda actor_y
00019Br 2                   cmp #180
00019Br 2                   beq block_actor
00019Br 2                   lda grid_base
00019Br 2                   sec
00019Br 2                   sbc #40
00019Br 2                   tax
00019Br 2                   lda #3
00019Br 2                   jmp scan_cells
00019Br 2               probe_right:
00019Br 2                   lda actor_x
00019Br 2                   cmp #31
00019Br 2                   bne @ordinary
00019Br 2                   lda grid_base
00019Br 2                   cmp #40
00019Br 2                   bcs @ordinary
00019Br 2                   lda #3                 ; room 12 $0484 = 3
00019Br 2               .if FULL_GAME
00019Br 2                   lda room_fields+2
00019Br 2               .endif
00019Br 2                   jmp set_door
00019Br 2               @ordinary:
00019Br 2                   lda grid_base
00019Br 2                   clc
00019Br 2                   adc #3
00019Br 2                   tax
00019Br 2                   lda #5
00019Br 2                   jmp scan_cells
00019Br 2               probe_left:
00019Br 2                   lda actor_x
00019Br 2                   cmp #7
00019Br 2                   bne @ordinary
00019Br 2                   lda grid_base
00019Br 2                   cmp #40
00019Br 2                   bcs @ordinary
00019Br 2                   lda #0                 ; room 12 $0483 = 0
00019Br 2               .if FULL_GAME
00019Br 2                   lda room_fields+1
00019Br 2               .endif
00019Br 2                   jmp set_door
00019Br 2               @ordinary:
00019Br 2                   lda grid_base
00019Br 2                   sec
00019Br 2                   sbc #4
00019Br 2                   tax
00019Br 2                   lda #4
00019Br 2                   jmp scan_cells
00019Br 2               probe_up:
00019Br 2                   lda actor_y
00019Br 2               .if FULL_GAME
00019Br 2                   ldx room_geometry
00019Br 2                   cmp geometry_far,x
00019Br 2               .else
00019Br 2                   cmp #140               ; geometry 1 far wall
00019Br 2               .endif
00019Br 2                   bne @ordinary
00019Br 2                   lda actor_x
00019Br 2                   cmp #19
00019Br 2                   bne block_actor
00019Br 2                   lda #1                 ; room 12 $0482 = 1 locked far door
00019Br 2               .if FULL_GAME
00019Br 2                   lda room_fields
00019Br 2               .endif
00019Br 2                   jmp set_door
00019Br 2               @ordinary:
00019Br 2                   lda grid_base
00019Br 2                   clc
00019Br 2                   adc #40
00019Br 2                   tax
00019Br 2                   lda #4
00019Br 2                   jmp scan_cells
00019Br 2               set_door:
00019Br 2                   sta door_status
00019Br 2                   cmp #3
00019Br 2               .if FULL_GAME
00019Br 2                   jcc block_actor
00019Br 2               .else
00019Br 2                   bcc block_actor
00019Br 2               .endif
00019Br 2                   rts
00019Br 2               scan_cells:
00019Br 2                   sta run_count
00019Br 2               @cell:
00019Br 2                   cpx #120
00019Br 2                   bcs @next              ; virtual empty cell; never read I/O
00019Br 2                   lda room12_grid,x
00019Br 2                   bpl @object
00019Br 2                   lda #1
00019Br 2                   sta blocked
00019Br 2               @object:
00019Br 2                   lda room12_grid,x
00019Br 2                   cmp #1
00019Br 2                   bne @next
00019Br 2                   sta object_status
00019Br 2               @next:
00019Br 2                   inx
00019Br 2                   dec run_count
00019Br 2                   bne @cell
00019Br 2                   rts
00019Br 2               .endif
00019Br 2               .if FULL_GAME
00019Br 2  00 01 FF 00  step_x: .byte 0,1,$FF,0
00019Fr 2  05 00 00 FB  step_y: .byte 5,0,0,$FB
0001A3r 2               ; Target foot planes: five source rows below the visible floor/back-wall seam.
0001A3r 2  91 7D 7D 9B  geometry_far: .byte 145,125,125,155
0001A7r 2               .else
0001A7r 2               step_x: .byte 0,2,$FE,0
0001A7r 2               step_y: .byte 10,0,0,$F6
0001A7r 2               .endif
