001580r 1               .export resident_end
001580r 1               resident_end:
001580r 1               .assert resident_end <= $A000, lderror, "Resident code/resources overlap terrain baseline"
001580r 1               .assert __AUXREAD_LOAD__+__AUXREAD_SIZE__ <= $A000, lderror, "Bank worker template overlaps baseline"
001580r 1               .assert __EXTRACODE_RUN__ >= HUD_BUFFER+40, lderror, "Extra code overlaps HUD scratch"
001580r 1               .assert __EXTRACODE_RUN__+__EXTRACODE_SIZE__ <= $0F00, lderror, "Extra code overlaps disk state"
001580r 1               .assert __PASSCODE_RUN__ >= STATE+29, lderror, "Checkpoint codec overlaps game state"
001580r 1               .assert __PASSCODE_RUN__+__PASSCODE_SIZE__ <= EVENT_LOG, lderror, "Checkpoint codec overlaps event log"
001580r 1               .assert __PASSUI_RUN__ >= DISK_BUFFER+$100, lderror, "Checkpoint UI overlaps disk buffer"
001580r 1               .assert __PASSUI_RUN__+__PASSUI_SIZE__ <= $2000, lderror, "Checkpoint UI overlaps graphics page 1"
001580r 1               .assert __PASSTAIL_RUN__ > code_crc_hi, lderror, "Checkpoint code overlaps scratch"
001580r 1               .assert __PASSTAIL_RUN__+__PASSTAIL_SIZE__ <= WORLD, lderror, "Checkpoint code overlaps WORLD"
001580r 1               
