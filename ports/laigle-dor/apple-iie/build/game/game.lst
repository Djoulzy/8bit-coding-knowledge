001D4Ar 2               .include "full-panels.inc"
001D4Ar 3               ; AUX script: row, column, zero-terminated text; $FF ends the page.
001D4Ar 3               ; MAIN code/stack and the established ZP AUX-read worker remain resident.
001D4Ar 3               full_panel_draw:
001D4Ar 3               @row:
001D4Ar 3  20 rr rr         jsr full_panel_get
001D4Dr 3  C9 FF            cmp #$FF
001D4Fr 3  F0 29            beq full_panel_dynamic
001D51r 3  20 rr rr         jsr full_text_address
001D54r 3  20 rr rr         jsr full_panel_get
001D57r 3  8D 2C 0F         sta panel_column
001D5Ar 3               @char:
