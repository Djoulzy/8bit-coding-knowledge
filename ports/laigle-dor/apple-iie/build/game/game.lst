001D5Dr 3  F0 EB            beq @row
001D5Fr 3  09 80            ora #$80
001D61r 3  AC 2C 0F         ldy panel_column
001D64r 3  91 82            sta (dst_ptr),y
001D66r 3  EE 2C 0F         inc panel_column
001D69r 3  4C rr rr         jmp @char
001D6Cr 3               full_panel_get:
001D6Cr 3  A0 00            ldy #0
001D6Er 3  20 rr rr         jsr aux_read_src
001D71r 3  E6 80            inc src_ptr
001D73r 3  D0 02            bne :+
001D75r 3  E6 81            inc src_ptr+1
001D77r 3               :
001D77r 3  C9 00            cmp #0                 ; callers test the byte, not the pointer INC flags
001D79r 3  60               rts
001D7Ar 3               
001D7Ar 3               full_panel_dynamic:
001D7Ar 3  AD 01 13         lda game_mode
001D7Dr 3  C9 05            cmp #MODE_DEAD
001D7Fr 3  90 18            bcc :+
001D81r 3  C9 08            cmp #MODE_NAME
001D83r 3  B0 14            bcs :+
001D85r 3  A9 04            lda #4
001D87r 3  20 rr rr         jsr full_text_address
001D8Ar 3  AD 0C 13         lda gold
001D8Dr 3  85 CD            sta word_tmp
001D8Fr 3  AD 0D 13         lda gold+1
001D92r 3  85 CE            sta word_tmp+1
001D94r 3  A0 1C            ldy #28
001D96r 3  4C rr rr         jmp full_decimal5
001D99r 3               :
001D99r 3  C9 10            cmp #MODE_CODE_SAVE
001D9Br 3  90 03 4C rr      jcs full_code_draw
001D9Fr 3  rr           
