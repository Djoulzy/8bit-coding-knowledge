00203Ar 2  A9 60            lda #$60
00203Cr 2  8D 20 0F         sta asset_page
00203Fr 2  A9 rr            lda #<((__ASSETS_SIZE__+$FF)/$100)
002041r 2  8D 21 0F         sta asset_pages
002044r 2  A9 06            lda #6
002046r 2  8D 06 0F         sta disk_wanted_track
002049r 2  A9 00            lda #0
00204Br 2  8D 07 0F         sta disk_wanted_sector
00204Er 2  A9 01            lda #1
002050r 2  8D 23 0F         sta asset_aux
002053r 2  20 rr rr         jsr asset_load_range
002056r 2               .if !HGR_MONO
