001DC3r 3  E8               inx
001DC4r 3  E0 06            cpx #6
001DC6r 3  D0 F3            bne @name
001DC8r 3  CA               dex
001DC9r 3               @trim:
001DC9r 3  BD 2D 13         lda player_name,x
001DCCr 3  C9 20            cmp #' '
001DCEr 3  D0 03            bne @suffix
