001945r 1               .include "apple/actor-cache.s"
001945r 2               ; Conservative per-page reuse of an idle, empty-handed actor. The central
001945r 2               ; region cannot overlap either wall flame. Moving actors, equipment, enemies,
001945r 2               ; hazards, pits and new terrain always use the ordinary compositor.
001945r 2               .export actor_cache, cache_frame
001945r 2               actor_cache:
001945r 2  A6 9E            ldx render_page_index
001947r 2  AD 01 13         lda game_mode
00194Ar 2  0D 03 13         ora held_item
00194Dr 2  0D 1C 13         ora action_kind
001950r 2  0D 24 13         ora enemy_kind
001953r 2  0D 23 13         ora hazard_active
001956r 2  0D 19 13         ora in_pit
001959r 2  0D 04 0C         ora walking
00195Cr 2  D0 3F            bne @invalidate
00195Er 2  20 rr rr         jsr full_is_dark
001961r 2  B0 3A            bcs @invalidate
