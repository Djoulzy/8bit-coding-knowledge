0000CEr 2  8D 00 0C         sta actor_x
0000D1r 2  A9 8C            lda #140
0000D3r 2  8D 01 0C         sta actor_y
0000D6r 2  A9 FF            lda #$FF
0000D8r 2  8D 0F 0C         sta key_action
0000DBr 2               .if FULL_GAME
0000DBr 2  4C rr rr         jmp full_reset
0000DEr 2               .else
0000DEr 2                   rts
0000DEr 2               .endif
0000DEr 2               
0000DEr 2               game_tick:
0000DEr 2               .if FULL_GAME
0000DEr 2  20 rr rr         jsr full_ui_key
0000E1r 2  90 01            bcc :+
0000E3r 2  60               rts
0000E4r 2               :
0000E4r 2               .endif
0000E4r 2  EE 06 0C         inc tick_lo
0000E7r 2  D0 03            bne :+
0000E9r 2  EE 07 0C         inc tick_hi
0000ECr 2               :
0000ECr 2               .if FULL_GAME
0000ECr 2  20 rr rr         jsr full_dispatch
0000EFr 2  90 03            bcc :+
0000F1r 2  4C rr rr         jmp update_frame
0000F4r 2               :
0000F4r 2               .endif
0000F4r 2  AD 0F 0C         lda key_action
0000F7r 2  C9 04            cmp #4
0000F9r 2  B0 3F            bcs @other
0000FBr 2  AD 04 0C         lda walking
0000FEr 2  F0 08            beq @direction
000100r 2  A9 02            lda #EVENT_STOP
000102r 2  20 rr rr         jsr log_event
000105r 2  4C rr rr         jmp stop_actor
000108r 2               @direction:
000108r 2  AD 03 0C         lda pose
00010Br 2  C9 04            cmp #4
00010Dr 2  90 0F            bcc @standing
00010Fr 2  AD 0F 0C         lda key_action
000112r 2  8D 02 0C         sta facing
000115r 2  18               clc
000116r 2  69 04            adc #4
000118r 2  8D 03 0C         sta pose
00011Br 2  4C rr rr         jmp update_frame
00011Er 2               @standing:
00011Er 2  AD 0F 0C         lda key_action
000121r 2  CD 02 0C         cmp facing
000124r 2  F0 09            beq @walk
000126r 2  8D 02 0C         sta facing
000129r 2  8D 03 0C         sta pose
00012Cr 2  4C rr rr         jmp update_frame
00012Fr 2               @walk:
00012Fr 2  A9 01            lda #1
000131r 2  8D 04 0C         sta walking
000134r 2  8D 05 0C         sta walk_phase
000137r 2  4C rr rr         jmp continue_walk
00013Ar 2               @other:
00013Ar 2  C9 04            cmp #4
00013Cr 2  D0 0D            bne @crouch
00013Er 2  AD 04 0C         lda walking
000141r 2  F0 20            beq stop_actor
000143r 2  A9 02            lda #EVENT_STOP
000145r 2  20 rr rr         jsr log_event
000148r 2  4C rr rr         jmp stop_actor
00014Br 2               @crouch:
00014Br 2  C9 05            cmp #5
00014Dr 2  D0 25            bne continue_walk
00014Fr 2  A9 00            lda #0
000151r 2  8D 04 0C         sta walking
000154r 2  8D 05 0C         sta walk_phase
000157r 2  AD 02 0C         lda facing
00015Ar 2  18               clc
00015Br 2  69 04            adc #4
00015Dr 2  8D 03 0C         sta pose
000160r 2  4C rr rr         jmp update_frame
000163r 2               
000163r 2               stop_actor:
000163r 2  A9 00            lda #0
000165r 2  8D 04 0C         sta walking
000168r 2  8D 05 0C         sta walk_phase
00016Br 2  AD 02 0C         lda facing
00016Er 2  8D 03 0C         sta pose
000171r 2  4C rr rr         jmp update_frame
000174r 2               
000174r 2               continue_walk:
000174r 2  AD 04 0C         lda walking
000177r 2  F0 3B            beq update_frame
000179r 2  20 rr rr         jsr collision_probe
00017Cr 2  AD 0C 0C         lda blocked
00017Fr 2  F0 08            beq @allowed
000181r 2  A9 04            lda #EVENT_BLOCKED
000183r 2  20 rr rr         jsr log_event
000186r 2  4C rr rr         jmp stop_actor
000189r 2               @allowed:
000189r 2  AD 0D 0C         lda door_status
00018Cr 2  C9 03            cmp #3
00018Er 2  D0 0B            bne @move
000190r 2  A9 03            lda #EVENT_EXIT
000192r 2  20 rr rr         jsr log_event
000195r 2               .if FULL_GAME
000195r 2  20 rr rr         jsr full_transition
000198r 2               .endif
000198r 2  4C rr rr         jmp stop_actor
00019Br 2               @move:
00019Br 2               .if FULL_GAME
00019Br 2  AD 60 13         lda move_x
00019Er 2  8D 00 0C         sta actor_x
0001A1r 2  AD 61 13         lda move_y
0001A4r 2  8D 01 0C         sta actor_y
0001A7r 2               .else
0001A7r 2                   ldx facing
0001A7r 2                   lda actor_x
0001A7r 2                   clc
0001A7r 2                   adc step_x,x
0001A7r 2                   sta actor_x
0001A7r 2                   lda actor_y
0001A7r 2                   clc
0001A7r 2                   adc step_y,x
0001A7r 2                   sta actor_y
0001A7r 2               .endif
0001A7r 2  AD 05 0C         lda walk_phase
0001AAr 2  49 01            eor #1
0001ACr 2  8D 05 0C         sta walk_phase
0001AFr 2  A9 01            lda #EVENT_WALK
0001B1r 2  20 rr rr         jsr log_event
0001B4r 2               update_frame:
0001B4r 2               .if FULL_GAME
0001B4r 2  20 rr rr         jsr full_action_frame
0001B7r 2  90 01            bcc :+
0001B9r 2  60               rts
0001BAr 2               :
0001BAr 2               .endif
0001BAr 2  AD 04 0C         lda walking
0001BDr 2  F0 0F            beq @static
0001BFr 2  AD 02 0C         lda facing
0001C2r 2  0A               asl a
0001C3r 2  18               clc
0001C4r 2  69 08            adc #8
0001C6r 2  18               clc
0001C7r 2  6D 05 0C         adc walk_phase
0001CAr 2  8D 10 0C         sta frame_id
0001CDr 2  60               rts
0001CEr 2               @static:
0001CEr 2  AD 03 0C         lda pose
0001D1r 2  8D 10 0C         sta frame_id
0001D4r 2  60               rts
0001D5r 2               
0001D5r 2               ; Bounded semantic map. A zero virtual cell replaces out-of-grid hardware reads
0001D5r 2               ; during y=150/170 transitions; this is an explicit provisional policy.
0001D5r 2               collision_probe:
0001D5r 2               .if FULL_GAME
0001D5r 2  4C rr rr         jmp full_collision_probe
0001D8r 2               .else
0001D8r 2                   lda #0
0001D8r 2                   sta blocked
0001D8r 2                   sta object_status
0001D8r 2                   lda #4
0001D8r 2                   sta door_status
0001D8r 2                   lda actor_x
0001D8r 2                   cmp #40
0001D8r 2                   bcs block_actor
0001D8r 2                   lda actor_y
0001D8r 2                   cmp #140
0001D8r 2                   bcc block_actor
0001D8r 2                   cmp #181
0001D8r 2                   bcs block_actor
0001D8r 2                   lda actor_x
0001D8r 2                   sta grid_base
0001D8r 2                   lda actor_y
0001D8r 2                   cmp #140
0001D8r 2                   bne :+
0001D8r 2                   lda grid_base
0001D8r 2                   clc
0001D8r 2                   adc #80
0001D8r 2                   sta grid_base
0001D8r 2               :
0001D8r 2                   lda actor_y
0001D8r 2                   cmp #160
0001D8r 2                   bne :+
0001D8r 2                   lda grid_base
0001D8r 2                   clc
0001D8r 2                   adc #40
0001D8r 2                   sta grid_base
0001D8r 2               :
0001D8r 2                   lda facing
0001D8r 2                   beq probe_down
0001D8r 2                   cmp #1
0001D8r 2                   beq probe_right
0001D8r 2                   cmp #2
0001D8r 2                   beq probe_left
0001D8r 2                   jmp probe_up
0001D8r 2               block_actor:
0001D8r 2                   lda #1
0001D8r 2                   sta blocked
0001D8r 2                   rts
0001D8r 2               probe_down:
0001D8r 2                   lda actor_y
0001D8r 2                   cmp #180
0001D8r 2                   beq block_actor
0001D8r 2                   lda grid_base
0001D8r 2                   sec
0001D8r 2                   sbc #40
0001D8r 2                   tax
0001D8r 2                   lda #3
0001D8r 2                   jmp scan_cells
0001D8r 2               probe_right:
0001D8r 2                   lda actor_x
0001D8r 2                   cmp #31
0001D8r 2                   bne @ordinary
0001D8r 2                   lda grid_base
0001D8r 2                   cmp #40
0001D8r 2                   bcs @ordinary
0001D8r 2                   lda #3                 ; room 12 $0484 = 3
0001D8r 2               .if FULL_GAME
0001D8r 2                   lda room_fields+2
0001D8r 2               .endif
0001D8r 2                   jmp set_door
0001D8r 2               @ordinary:
0001D8r 2                   lda grid_base
0001D8r 2                   clc
0001D8r 2                   adc #3
0001D8r 2                   tax
0001D8r 2                   lda #5
0001D8r 2                   jmp scan_cells
0001D8r 2               probe_left:
0001D8r 2                   lda actor_x
0001D8r 2                   cmp #7
0001D8r 2                   bne @ordinary
0001D8r 2                   lda grid_base
0001D8r 2                   cmp #40
0001D8r 2                   bcs @ordinary
0001D8r 2                   lda #0                 ; room 12 $0483 = 0
0001D8r 2               .if FULL_GAME
0001D8r 2                   lda room_fields+1
0001D8r 2               .endif
0001D8r 2                   jmp set_door
0001D8r 2               @ordinary:
0001D8r 2                   lda grid_base
0001D8r 2                   sec
0001D8r 2                   sbc #4
0001D8r 2                   tax
0001D8r 2                   lda #4
0001D8r 2                   jmp scan_cells
0001D8r 2               probe_up:
0001D8r 2                   lda actor_y
0001D8r 2               .if FULL_GAME
0001D8r 2                   ldx room_geometry
0001D8r 2                   cmp geometry_far,x
0001D8r 2               .else
0001D8r 2                   cmp #140               ; geometry 1 far wall
0001D8r 2               .endif
0001D8r 2                   bne @ordinary
0001D8r 2                   lda actor_x
0001D8r 2                   cmp #19
0001D8r 2                   bne block_actor
0001D8r 2                   lda #1                 ; room 12 $0482 = 1 locked far door
0001D8r 2               .if FULL_GAME
0001D8r 2                   lda room_fields
0001D8r 2               .endif
0001D8r 2                   jmp set_door
0001D8r 2               @ordinary:
0001D8r 2                   lda grid_base
0001D8r 2                   clc
0001D8r 2                   adc #40
0001D8r 2                   tax
0001D8r 2                   lda #4
0001D8r 2                   jmp scan_cells
0001D8r 2               set_door:
0001D8r 2                   sta door_status
0001D8r 2                   cmp #3
0001D8r 2               .if FULL_GAME
0001D8r 2                   jcc block_actor
0001D8r 2               .else
0001D8r 2                   bcc block_actor
0001D8r 2               .endif
0001D8r 2                   rts
0001D8r 2               scan_cells:
0001D8r 2                   sta run_count
0001D8r 2               @cell:
0001D8r 2                   cpx #120
0001D8r 2                   bcs @next              ; virtual empty cell; never read I/O
0001D8r 2                   lda room12_grid,x
0001D8r 2                   bpl @object
0001D8r 2                   lda #1
0001D8r 2                   sta blocked
0001D8r 2               @object:
0001D8r 2                   lda room12_grid,x
0001D8r 2                   cmp #1
0001D8r 2                   bne @next
0001D8r 2                   sta object_status
0001D8r 2               @next:
0001D8r 2                   inx
0001D8r 2                   dec run_count
0001D8r 2                   bne @cell
0001D8r 2                   rts
0001D8r 2               .endif
0001D8r 2               .if FULL_GAME
0001D8r 2  00 01 FF 00  step_x: .byte 0,1,$FF,0
0001DCr 2  05 00 00 FB  step_y: .byte 5,0,0,$FB
0001E0r 2               ; Target foot planes: five source rows below the visible floor/back-wall seam.
0001E0r 2  91 7D 7D 9B  geometry_far: .byte 145,125,125,155
0001E4r 2               .else
0001E4r 2               step_x: .byte 0,2,$FE,0
0001E4r 2               step_y: .byte 10,0,0,$F6
0001E4r 2               .endif
0001E4r 2               
0001E4r 1               .include "game/full-core.s"
0001E4r 2               ; Source-backed target rules, original B2 BASIC line numbers in each section.
0001E4r 2               ; Integer hundredths for strength/drain; target LFSR replaces ROM RND/timer.
0001E4r 2               ; One service opportunity per target tick is an explicit cadence adaptation.
0001E4r 2               .export full_reset, full_dispatch, full_clock, full_transition, full_action_frame
0001E4r 2               .export world_decode, world_scene_flags, full_pickup, full_open, full_purchase
