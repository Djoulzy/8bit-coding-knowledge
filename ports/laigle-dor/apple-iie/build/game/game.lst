001E19r 3  86 D7            stx menu_ptr+1
001E1Br 3  A9 15            lda #21
001E1Dr 3  20 rr rr         jsr full_text_address
001E20r 3  A0 03            ldy #3
001E22r 3  4C rr rr         jmp full_hud_string
