001DF8r 3  20 rr rr         jsr full_decimal5
001DFBr 3  A0 10            ldy #16
001DFDr 3  A2 05            ldx #5
001DFFr 3  20 rr rr         jsr full_hud_trim
001E02r 3  AD 20 13         lda message_id
001E05r 3  C9 01            cmp #1
