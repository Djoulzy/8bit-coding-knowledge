002030r 1               .include "apple/asset-loader.s"
002030r 2               ; One startup preload of the shared atlas. No disk access on room changes.
002030r 2               ; Exact private 16-sector slot-6 BOOT0 ABI; same pinned firmware as boot.s.
002030r 2               .import __ASSETS_SIZE__, __TEXTASSETS_SIZE__
002030r 2               .if !HGR_MONO
002030r 2               .import __ASSETEXTRA_SIZE__
002030r 2               .endif
