001968r 2  90 33            bcc @invalidate
00196Ar 2  C9 1C            cmp #28
00196Cr 2  B0 2F            bcs @invalidate
00196Er 2  AD 3D 13         lda terrain_pending
001971r 2  3D rr rr         and title_page_bits,x
001974r 2  D0 2E            bne @remember
001976r 2  BD 1B 0C         lda dirty_valid,x
001979r 2  F0 29            beq @remember
00197Br 2  AD 00 0C         lda actor_x
00197Er 2  DD 40 13         cmp cache_x,x
001981r 2  D0 21            bne @remember
001983r 2  AD 01 0C         lda actor_y
001986r 2  DD 42 13         cmp cache_y,x
001989r 2  D0 19            bne @remember
00198Br 2  AD 02 0C         lda facing
00198Er 2  DD 44 13         cmp cache_facing,x
001991r 2  D0 11            bne @remember
001993r 2  AD 10 0C         lda frame_id
001996r 2  DD 46 13         cmp cache_frame,x
001999r 2  D0 09            bne @remember
00199Br 2  38               sec
00199Cr 2  60               rts
00199Dr 2               @invalidate:
00199Dr 2  A9 FF            lda #$FF
00199Fr 2  9D 46 13         sta cache_frame,x
0019A2r 2  18               clc
0019A3r 2  60               rts
0019A4r 2               @remember:
0019A4r 2  AD 00 0C         lda actor_x
0019A7r 2  9D 40 13         sta cache_x,x
