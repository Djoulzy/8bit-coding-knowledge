00119Cr 1               .include "apple/dhgr.s"
00119Cr 2               ; Mixed DHGR, two MAIN+AUX frame pairs; immutable terrain in both $A000 banks.
00119Cr 2               ; No firmware calls or mirrored application code. RAMRD aux reads run in ZP.
00119Cr 2               .export video_init, draw_scene, draw_sprite, present_frame, present_flip
00119Cr 2               .export display_page_hi, draw_page_hi, dirty_left, dirty_right, dirty_top, dirty_bottom, dirty_valid
