0019BEr 1               .include "apple/service-clock.s"
0019BEr 2               ; Sample IIe RDVBLBAR at bounded rendering intervals. Only periodic strength
0019BEr 2               ; loss and torch wear use this timebase; collision/action rules stay immediate.
0019BEr 2               ; 18 refreshes approximate the previous warm-room ~300 ms at 60 Hz.
0019BEr 2               .export clock_sample, clock_reset, clock_vbls, clock_last_vbl
0019BEr 2               SERVICE_REFRESHES = 18
0019BEr 2               clock_reset:
0019BEr 2  A9 00            lda #0
0019C0r 2  8D 48 13         sta clock_vbls
0019C3r 2  AD 19 C0         lda $C019
0019C6r 2  29 80            and #$80
0019C8r 2  8D 49 13         sta clock_last_vbl
0019CBr 2  60               rts
0019CCr 2               clock_sample:
0019CCr 2  48               pha
0019CDr 2  AD 01 13         lda game_mode
0019D0r 2  F0 05            beq :+
0019D2r 2  A9 00            lda #0
0019D4r 2  8D 48 13         sta clock_vbls          ; menus/help pause wear, with no accumulated debt
0019D7r 2               :
0019D7r 2  AD 19 C0         lda $C019
0019DAr 2  29 80            and #$80
0019DCr 2  CD 49 13         cmp clock_last_vbl
0019DFr 2  F0 16            beq @done
0019E1r 2  8D 49 13         sta clock_last_vbl
0019E4r 2  C9 00            cmp #0
0019E6r 2  D0 0F            bne @done              ; count entry into blank, not both transitions
0019E8r 2  AD 01 13         lda game_mode
0019EBr 2  D0 0A            bne @done
0019EDr 2  AD 48 13         lda clock_vbls
0019F0r 2  C9 23            cmp #(SERVICE_REFRESHES*2-1)
0019F2r 2  B0 03            bcs @done              ; bounded pending time, no runaway catch-up
0019F4r 2  EE 48 13         inc clock_vbls
0019F7r 2               @done:
0019F7r 2  68               pla
0019F8r 2  60               rts
0019F9r 2               
