002056r 2  A9 0C            lda #$0C
002058r 2  8D 20 0F         sta asset_page
00205Br 2  A9 rr            lda #<((__ASSETEXTRA_SIZE__+$FF)/$100)
00205Dr 2  8D 21 0F         sta asset_pages
002060r 2  A9 15            lda #21                 ; sector 336, after the three HGR maps
002062r 2  8D 06 0F         sta disk_wanted_track
002065r 2  A9 00            lda #0
002067r 2  8D 07 0F         sta disk_wanted_sector
00206Ar 2  20 rr rr         jsr asset_load_range
00206Dr 2               .endif
00206Dr 2                   ; Full TEXT panels live in AUX $1400-$1FFF, separate from MAIN LOWCODE.
00206Dr 2  A9 14            lda #$14
00206Fr 2  8D 20 0F         sta asset_page
002072r 2  A9 rr            lda #<((__TEXTASSETS_SIZE__+$FF)/$100)
002074r 2  8D 21 0F         sta asset_pages
002077r 2  A9 0E            lda #14                  ; physical sector 224, after the title raster
002079r 2  8D 06 0F         sta disk_wanted_track
00207Cr 2  A9 00            lda #0
