000000r 1               ; Original project boot sector, ca65/NMOS. Disk II 16-sector controller, slot 6.
000000r 1               ; BOOT0 reads sector 0 to $0800, then JMP $0801. We call its private reader
000000r 1               ; at $C65C with $26/27=destination, $3D=sector, $41=track, X=$60, C clear.
000000r 1               ; Reader increments destination and sector, then returns via JMP $0801.
000000r 1               ; Assumes exact 16-sector BOOT0 contract pinned in tools/dependencies.json.
000000r 1               .setcpu "6502"
000000r 1               .segment "BOOT"
000000r 1  01               .byte 1
000001r 1               .export boot_entry
000001r 1               boot_entry:
000001r 1  78               sei
000002r 1  D8               cld
000003r 1  AD rr rr         lda started
000006r 1  D0 14            bne next_track
000008r 1  EE rr rr         inc started
00000Br 1  A9 00            lda #0
00000Dr 1  85 26            sta $26
00000Fr 1  85 41            sta $41
000011r 1  A9 60            lda #$60
000013r 1  85 27            sta $27
000015r 1  A9 01            lda #1
000017r 1  85 3D            sta $3D                 ; T0/S0 holds this loader, payload starts T0/S1
000019r 1  4C rr rr         jmp read_track
00001Cr 1               next_track:
00001Cr 1  A5 27            lda $27
00001Er 1  C9 9A            cmp #APP_END_PAGE
000020r 1  B0 23            bcs loaded
000022r 1  E6 41            inc $41
000024r 1  20 rr rr         jsr step_half
000027r 1  20 rr rr         jsr step_half
00002Ar 1  A9 00            lda #0
00002Cr 1  85 3D            sta $3D
00002Er 1               read_track:
00002Er 1                   ; Number of sectors BOOT0 should read on this track, exclusive upper bound.
00002Er 1  A9 9A            lda #APP_END_PAGE
000030r 1  38               sec
000031r 1  E5 27            sbc $27
000033r 1  18               clc
000034r 1  65 3D            adc $3D
000036r 1  C9 10            cmp #16
000038r 1  90 02            bcc :+
00003Ar 1  A9 10            lda #16
00003Cr 1               :
00003Cr 1  8D 00 08         sta $0800
00003Fr 1  A2 60            ldx #$60
000041r 1  18               clc
000042r 1  4C 5C C6         jmp $C65C
000045r 1               loaded:
000045r 1  AD E8 C0         lda $C0E8               ; stop drive motor; application never needs disk IRQ
000048r 1  4C 00 60         jmp $6000
00004Br 1               step_half:
00004Br 1  AD rr rr         lda phase
00004Er 1  18               clc
00004Fr 1  69 02            adc #2
000051r 1  29 06            and #6
000053r 1  AA               tax
000054r 1  BD E1 C0         lda $C0E1,x             ; energize next adjacent coil
000057r 1  AE rr rr         ldx phase
00005Ar 1  BD E0 C0         lda $C0E0,x             ; release previous coil
00005Dr 1  AD rr rr         lda phase
000060r 1  18               clc
000061r 1  69 02            adc #2
000063r 1  29 06            and #6
000065r 1  8D rr rr         sta phase
000068r 1  A2 18            ldx #24                 ; conservative software settle; not measured hardware
00006Ar 1               @wait:
00006Ar 1  A0 00            ldy #0
00006Cr 1               @inner:
00006Cr 1  88               dey
00006Dr 1  D0 FD            bne @inner
00006Fr 1  CA               dex
000070r 1  D0 F8            bne @wait
000072r 1  60               rts
000073r 1  00           started: .byte 0
000074r 1  00           phase: .byte 0
000075r 1  00 00 00 00      .res $100-(*-boot_entry+1),0
000079r 1  00 00 00 00  
00007Dr 1  00 00 00 00  
000075r 1               
