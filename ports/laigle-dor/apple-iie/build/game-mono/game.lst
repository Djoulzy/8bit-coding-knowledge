0018FFr 1               .include "apple/actor-cache.s"
0018FFr 2               ; Conservative per-page reuse of an idle, empty-handed actor. The central
0018FFr 2               ; region cannot overlap either wall flame. Moving actors, equipment, enemies,
0018FFr 2               ; hazards, pits and new terrain always use the ordinary compositor.
0018FFr 2               .export actor_cache, cache_frame
0018FFr 2               actor_cache:
0018FFr 2  A6 9E            ldx render_page_index
001901r 2  AD 01 13         lda game_mode
001904r 2  0D 03 13         ora held_item
001907r 2  0D 1C 13         ora action_kind
00190Ar 2  0D 24 13         ora enemy_kind
00190Dr 2  0D 23 13         ora hazard_active
001910r 2  0D 19 13         ora in_pit
001913r 2  0D 04 0C         ora walking
001916r 2  D0 3F            bne @invalidate
001918r 2  20 rr rr         jsr full_is_dark
