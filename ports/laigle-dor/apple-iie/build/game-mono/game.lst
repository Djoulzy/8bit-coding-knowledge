001F92r 2  A9 60            lda #$60
001F94r 2  8D 20 0F         sta asset_page
001F97r 2  A9 rr            lda #<((__ASSETS_SIZE__+$FF)/$100)
001F99r 2  8D 21 0F         sta asset_pages
