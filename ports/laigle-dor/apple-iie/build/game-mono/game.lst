001FA1r 2  A9 00            lda #0
001FA3r 2  8D 07 0F         sta disk_wanted_sector
001FA6r 2  A9 01            lda #1
001FA8r 2  8D 23 0F         sta asset_aux
001FABr 2  20 rr rr         jsr asset_load_range
