001FAEr 2                   ; Additional native scanlines use low AUX RAM, never MAIN disk workspaces.
001FAEr 2                   lda #$0C
001FAEr 2                   sta asset_page
001FAEr 2                   lda #<((__ASSETEXTRA_SIZE__+$FF)/$100)
001FAEr 2                   sta asset_pages
001FAEr 2                   lda #21                 ; sector 336, after the three HGR maps
001FAEr 2                   sta disk_wanted_track
001FAEr 2                   lda #0
001FAEr 2                   sta disk_wanted_sector
001FAEr 2                   jsr asset_load_range
001FAEr 2               .endif
001FAEr 2                   ; Full TEXT panels live in AUX $1400-$1FFF, separate from MAIN LOWCODE.
001FAEr 2  A9 14            lda #$14
001FB0r 2  8D 20 0F         sta asset_page
001FB3r 2  A9 rr            lda #<((__TEXTASSETS_SIZE__+$FF)/$100)
001FB5r 2  8D 21 0F         sta asset_pages
