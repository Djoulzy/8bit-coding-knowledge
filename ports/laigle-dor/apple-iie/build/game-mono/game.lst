001940r 2  DD 42 13         cmp cache_y,x
001943r 2  D0 19            bne @remember
001945r 2  AD 02 0C         lda facing
001948r 2  DD 44 13         cmp cache_facing,x
00194Br 2  D0 11            bne @remember
00194Dr 2  AD 10 0C         lda frame_id
001950r 2  DD 46 13         cmp cache_frame,x
001953r 2  D0 09            bne @remember
001955r 2  38               sec
001956r 2  60               rts
001957r 2               @invalidate:
001957r 2  A9 FF            lda #$FF
001959r 2  9D 46 13         sta cache_frame,x
00195Cr 2  18               clc
00195Dr 2  60               rts
