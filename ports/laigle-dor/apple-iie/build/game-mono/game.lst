0001E4r 2               .export room_geometry, room_light, room_features, room_fields, room_treasure
0001E4r 2               .export room_furnishing, scene_flags, enemy_kind, enemy_x, enemy_y, hazard_active
0001E4r 2               .export enemy_direction, enemy_contact, enemy_life, hazard_x, raw_key, message_id
