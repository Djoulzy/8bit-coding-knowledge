001F88r 1               .include "apple/asset-loader.s"
001F88r 2               ; One startup preload of the shared atlas. No disk access on room changes.
001F88r 2               ; Exact private 16-sector slot-6 BOOT0 ABI; same pinned firmware as boot.s.
001F88r 2               .import __ASSETS_SIZE__, __TEXTASSETS_SIZE__
001F88r 2               .if !HGR_MONO
