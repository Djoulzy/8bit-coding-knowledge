001978r 1               .include "apple/service-clock.s"
001978r 2               ; Sample IIe RDVBLBAR at bounded rendering intervals. Only periodic strength
001978r 2               ; loss and torch wear use this timebase; collision/action rules stay immediate.
001978r 2               ; 18 refreshes approximate the previous warm-room ~300 ms at 60 Hz.
001978r 2               .export clock_sample, clock_reset, clock_vbls, clock_last_vbl
001978r 2               SERVICE_REFRESHES = 18
001978r 2               clock_reset:
001978r 2  A9 00            lda #0
00197Ar 2  8D 48 13         sta clock_vbls
00197Dr 2  AD 19 C0         lda $C019
001980r 2  29 80            and #$80
001982r 2  8D 49 13         sta clock_last_vbl
001985r 2  60               rts
001986r 2               clock_sample:
001986r 2  48               pha
001987r 2  AD 01 13         lda game_mode
00198Ar 2  F0 05            beq :+
00198Cr 2  A9 00            lda #0
00198Er 2  8D 48 13         sta clock_vbls          ; menus/help pause wear, with no accumulated debt
001991r 2               :
001991r 2  AD 19 C0         lda $C019
001994r 2  29 80            and #$80
001996r 2  CD 49 13         cmp clock_last_vbl
001999r 2  F0 16            beq @done
00199Br 2  8D 49 13         sta clock_last_vbl
00199Er 2  C9 00            cmp #0
0019A0r 2  D0 0F            bne @done              ; count entry into blank, not both transitions
0019A2r 2  AD 01 13         lda game_mode
0019A5r 2  D0 0A            bne @done
0019A7r 2  AD 48 13         lda clock_vbls
0019AAr 2  C9 23            cmp #(SERVICE_REFRESHES*2-1)
0019ACr 2  B0 03            bcs @done              ; bounded pending time, no runaway catch-up
0019AEr 2  EE 48 13         inc clock_vbls
0019B1r 2               @done:
0019B1r 2  68               pla
0019B2r 2  60               rts
0019B3r 2               
0019B3r 1               .include "apple/hud.s"
