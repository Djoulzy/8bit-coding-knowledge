; World port allocation, outside graphics, text and private renderer scratch.
WORLD = $1000             ; $1000-$11FF mutable original packed records
GRID = $1200              ; $1200-$1277 current 3x40 semantic collision map
room_geometry = $1280
room_light = $1281
room_features = $1282
room_fields = $1284       ; twelve two-bit fields, source $0482-$048D
room_treasure = $1290
room_furnishing = $1291
room_variation = $1292
room_gate = $1293
room_floor = $1294
lamp_history = $12A0      ; sixty-four room-local fixture bits
GAME_STATE = $1300
current_room = GAME_STATE
game_mode = GAME_STATE+1  ; 0 play,1 exterior,2 merchant,3 inventory,4 reading,5 dead,6 won,7 departure
room_dirty = GAME_STATE+2
held_item = GAME_STATE+3  ; source AB: 0/1/9/8/10/6
vials = GAME_STATE+4
torches = GAME_STATE+5
ropes = GAME_STATE+6
crowbars = GAME_STATE+7
possessions = GAME_STATE+8 ; iron1,gold2,ring4,lead8
scrolls = GAME_STATE+9
objectives = GAME_STATE+10 ; missing book1,diamond2,eagle4 (inverted possession)
poison = GAME_STATE+11
gold = GAME_STATE+12       ; unsigned 16-bit
points = GAME_STATE+14
energy = GAME_STATE+16     ; signed 16-bit hundredths, initial 10000
drain = GAME_STATE+18      ; hundredths per target controller tick
torch_life = GAME_STATE+20 ; integer floor of source lifetime, strict <0 wear
bar_life = GAME_STATE+22
pit_room = GAME_STATE+23
pit_x = GAME_STATE+24
in_pit = GAME_STATE+25
pit_wait = GAME_STATE+26
passage = GAME_STATE+27
action_kind = GAME_STATE+28 ; drink1,vertical2,jump3,climb4
action_phase = GAME_STATE+29
saved_item = GAME_STATE+30
chest_open = GAME_STATE+31
message_id = GAME_STATE+32
gate_side = GAME_STATE+33
gate_jump = GAME_STATE+34
hazard_active = GAME_STATE+35
enemy_kind = GAME_STATE+36
enemy_x = GAME_STATE+37
enemy_y = GAME_STATE+38
enemy_phase = GAME_STATE+39
rng_state = GAME_STATE+40 ; deterministic target LFSR, not Oric RND equivalence
scene_flags = GAME_STATE+42
reading_page = GAME_STATE+43
session_attempt = GAME_STATE+44
player_name = GAME_STATE+45 ; six ASCII characters
raw_key = GAME_STATE+51
scene_mask = GAME_STATE+52
disk_tracks = $0F00       ; drive-1 track + reserved byte; recorded before HUD takes $0800
disk_phases = $0F02
disk_track = $0F04
disk_phase = $0F05
disk_wanted_track = $0F06
disk_wanted_sector = $0F07
disk_cursor = $0F08
disk_cache_valid = $0F09
disk_drive2_ready = $0F0C
disk_return_saved = $0F10 ; four bytes from text page 2 patched only in TEXT mode
DISK_BUFFER = $1E00      ; MAIN, one decoded physical sector
; LOWCODE runs at MAIN $1400-$1CFF; installed before baselines overwrite load image.
copy_ptr = $BD
word_tmp = $CD
word_arg = $CF
math_count = $D1
game_tmp = $D2
game_tmp2 = $D3
message_ptr = $D4
menu_ptr = $D6
game_error = $D8
equip_index = $D9
game_key = $DA
enemy_direction = GAME_STATE+53
enemy_contact = GAME_STATE+54
enemy_life = GAME_STATE+55
enemy_contact_cue = GAME_STATE+56
hazard_x = GAME_STATE+57
MODE_PLAY = 0
MODE_EXTERIOR = 1
MODE_MERCHANT = 2
MODE_INVENTORY = 3
MODE_READ = 4
MODE_DEAD = 5
MODE_WIN = 6
MODE_DEPART = 7
MODE_NAME = 8
MODE_TITLE = 9
title_tick = GAME_STATE+58
title_stage = GAME_STATE+59
title_pages_ready = GAME_STATE+60 ; one bit for each revealed frame pair
terrain_pending = GAME_STATE+61 ; frame pairs needing a full hidden-page copy
line_pattern = $F5
tile_format = $DC
static_draw = $DD
line_x = $DE
line_y = $DF
line_end_x = $E0
line_end_y = $E1
line_dx = $E2
line_dy = $E3
line_sx = $E4
line_sy = $E5
line_err = $E6
line_twice = $E8
scene_x = $EA
scene_y = $EB
scene_count = $EC
scene_step = $ED
scene_id = $EE
scene_additive = $EF
actor_saved = $1358       ; four bytes used during static scene/effect drawing
extra_rects = $1340       ; reserved for independent dynamic restoration regions
move_x = $1360           ; proposed foot position, game/proximity.s
move_y = $1361
tile_accent = $DB        ; optional two-bit tile status 3, header byte 11
EVENT_ROOM = 5
EVENT_ITEM = 6
EVENT_DENIED = 7
EVENT_DAMAGE = 8
EVENT_ACTION = 9
EVENT_END = 10
